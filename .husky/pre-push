BRANCH=$(git rev-parse --abbrev-ref HEAD)

if [ "$BRANCH" = "main" ]; then
    ZERO_SHA="0000000000000000000000000000000000000000"

    while read local_ref local_sha remote_ref remote_sha; do
        if [ "$remote_ref" != "refs/heads/main" ] || [ "$remote_sha" = "$ZERO_SHA" ]; then
            continue
        fi

        LOCAL_VERSION=$(node -e "const {execFileSync}=require('node:child_process'); const ref=process.argv[1]+':package.json'; console.log(JSON.parse(execFileSync('git',['show',ref],{encoding:'utf8'})).version)" "$local_sha" 2>/dev/null)
        REMOTE_VERSION=$(node -e "const {execFileSync}=require('node:child_process'); const ref=process.argv[1]+':package.json'; console.log(JSON.parse(execFileSync('git',['show',ref],{encoding:'utf8'})).version)" "$remote_sha" 2>/dev/null)

        if [ -n "$LOCAL_VERSION" ] && [ "$LOCAL_VERSION" = "$REMOTE_VERSION" ]; then
            echo "⚠️  エラー: main のアプリバージョンが更新されていません。"
            echo "通常の commit をやり直すと pre-commit がバージョンを自動更新します。"
            exit 1
        fi

        echo "✅ Version $LOCAL_VERSION を含む main push を同期実行します。"
    done
fi
